create extension if not exists "uuid-ossp";

create table public.problems (
  id uuid primary key default uuid_generate_v4(),
  user_id uuid references auth.users(id) on delete set null,
  title text not null,
  description text not null,
  category text,
  country text,
  city text,
  anonymous boolean default false,

  demand_score integer default 0,
  opportunity_score integer default 0,
  solvability_score integer default 0,
  trend_score integer default 0,

  ai_summary text,
  ai_business_ideas jsonb default '[]'::jsonb,
  ai_target_customers jsonb default '[]'::jsonb,
  ai_recommended_solution text,

  status text default 'analyzed',

  created_at timestamptz default now(),
  updated_at timestamptz default now()
);

create table public.problem_votes (
  id uuid primary key default uuid_generate_v4(),
  problem_id uuid references public.problems(id) on delete cascade,
  user_id uuid references auth.users(id) on delete cascade,
  created_at timestamptz default now(),

  unique(problem_id, user_id)
);

create table public.problem_follows (
  id uuid primary key default uuid_generate_v4(),
  problem_id uuid references public.problems(id) on delete cascade,
  user_id uuid references auth.users(id) on delete cascade,
  created_at timestamptz default now(),

  unique(problem_id, user_id)
);

alter table public.problems enable row level security;
alter table public.problem_votes enable row level security;
alter table public.problem_follows enable row level security;

create policy "Anyone can view analyzed problems"
on public.problems
for select
using (status = 'analyzed' or auth.uid() = user_id);

create policy "Authenticated users can submit problems"
on public.problems
for insert
with check (auth.uid() = user_id);

create policy "Users can update their own problems"
on public.problems
for update
using (auth.uid() = user_id);

create policy "Users can vote"
on public.problem_votes
for insert
with check (auth.uid() = user_id);

create policy "Users can remove their vote"
on public.problem_votes
for delete
using (auth.uid() = user_id);

create policy "Users can follow"
on public.problem_follows
for insert
with check (auth.uid() = user_id);

create policy "Users can unfollow"
on public.problem_follows
for delete
using (auth.uid() = user_id);
